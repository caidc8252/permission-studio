{
  "name": "permission-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "node --use-env-proxy ./node_modules/next/dist/bin/next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "node --use-env-proxy ./node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3100",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@babel/parser": "7.28.6",
    "@dagrejs/dagre": "3.1.1",
    "@xyflow/react": "12.11.3",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/dagre": "0.7.54",
    "@types/node": "24.10.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.2",
    "globals": "17.4.0",
    "jsdom": "28.1.0",
    "prettier": "3.8.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.6"
  },
  "packageManager": "pnpm@10.18.3"
}
